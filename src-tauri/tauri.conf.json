{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZI Player",
  "version": "0.3.5",
  "identifier": "com.jayden.zi-player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZI Player",
        "width": 1080,
        "height": 720,
        "minWidth": 380,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/yt-dlp/yt-dlp", "binaries/ffmpeg/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2NDU3MTFCOEEzQzQyRDcKUldUWFFqeUtHM0ZGZHZ2UkdpRFFndDVLYkJ6YUxuVGN5dXU4ZEZoVWZoVGpic012ZlA1dEVIRkEK",
      "endpoints": [
        "https://github.com/awrff/zi-player/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
